generator client {
  provider            = "prisma-client"
  output              = "../src/infra/database/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "mysql"
}

enum WorkspaceType {
  COMPANY
  INDIVIDUAL
}

enum WorkspaceRole {
  OWNER
  ADMIN
  RECRUITER
}

model User {
  id                   String               @id @default(uuid(7))
  name                 String               @db.VarChar(120)
  email                String               @unique @db.VarChar(254)
  password             String               @db.VarChar(60)
  active               Boolean              @default(true)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  deletedAt            DateTime?
  refreshTokenFamilies RefreshTokenFamily[]
  individualWorkspace  Workspace?
  workspaceMemberships WorkspaceMember[]
}

model RefreshTokenFamily {
  id        String         @id @default(uuid(7))
  userId    String
  revokedAt DateTime?
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokens    RefreshToken[]
}

model RefreshToken {
  id        String             @id @default(uuid(7))
  familyId  String
  tokenHash String             @unique @db.Char(64)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime           @default(now())
  family    RefreshTokenFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)
}

model Workspace {
  id                String            @id @default(uuid(7))
  type              WorkspaceType
  name              String            @db.VarChar(120)
  individualOwnerId String?           @unique
  active            Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?
  individualOwner   User?             @relation(fields: [individualOwnerId], references: [id], onDelete: Cascade)
  members           WorkspaceMember[]
}

model WorkspaceMember {
  workspaceId String
  userId      String
  role        WorkspaceRole
  createdAt   DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
}
